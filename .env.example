# --- NEET v1 (dataset scraper) ---
# Met Office DataPoint key (legacy; optional)
METOFFICE_API_KEY=

# --- NEET v2 forward capture (`neet capture`) ---
# Where raw captures go (on the Mac mini: the Google Drive CivicVerifierData folder)
NEET_DATA_ROOT=
# Met Office Weather DataHub (site-specific forecast; free tier 360 calls/day)  https://datahub.metoffice.gov.uk/
METOFFICE_DATAHUB_KEY=
# Met Office NSWWS public API key (register via DataHub; product "NSWWS")
NSWWS_KEY=
# Bus Open Data Service API key  https://data.bus-data.dft.gov.uk/account/settings/
BODS_KEY=
# Bluesky: your handle and an APP PASSWORD (Settings -> Privacy and security -> App passwords), never the account password
BSKY_HANDLE=
BSKY_APP_PASSWORD=
# Random secret used to pseudonymise author DIDs at ingest (any long random string; keep it stable)
PSEUDONYM_SALT=
